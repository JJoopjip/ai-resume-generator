#!/usr/bin/env sh
# resume-gen — one entrypoint for the whole pipeline.
#
#   resume-gen <job-description-file>   Tailor + render, end to end:
#                                       launches a scripted, headless Claude Code
#                                       session (TECH_SPEC.md §6) that selects
#                                       content from master.yaml per
#                                       prompts/tailor_resume.md, writes
#                                       instance.yaml, then drives the render/
#                                       overflow loop itself.
#
#   resume-gen render|validate ...      Deterministic, no-LLM renderer/validator,
#                                       run inside the Docker image
#                                       (build once: docker build -t resume-gen .)
#
# Control direction (per TECH_SPEC §6): the launcher only *starts* Claude for
# the tailor stage — Claude then calls `resume-gen render`. The renderer itself
# never calls back into Claude.

set -eu

case "${1:-}" in
  render|validate|"")
    # Deterministic stage — hand straight to the container. A named volume backs
    # Tectonic's package/font cache so it survives `--rm` and is shared across
    # every render (the image already ships a warm cache; this also catches any
    # package a future template adds that the image's warm step missed).
    exec docker run --rm \
      -v "$(pwd)":/work \
      -v resume-gen-tectonic-cache:/home/appuser/.cache/Tectonic \
      resume-gen "$@"
    ;;
  -h|--help)
    sed -n '2,20p' "$0"
    exit 0
    ;;
esac

# ---- Tailor stage: headless Claude Code one-shot -----------------------------
JD_INPUT="$1"
if [ ! -f "$JD_INPUT" ]; then
  echo "resume-gen: '$JD_INPUT' is not a file. Pass a job-description file, or use 'render'/'validate'." >&2
  exit 4
fi
JD="$(realpath "$JD_INPUT")"
TODAY="$(date +%F)"

# Model/effort pinned for reproducibility: Sonnet 5 / medium is a strong,
# cost-effective default for JD->bullet selection (the validator guards
# correctness regardless of model). Bump to `--model claude-opus-4-8 --effort
# high` for the sharpest selection on a high-stakes application. Perms
# pre-authorize the tools the headless run needs (write instance.yaml, shell
# `resume-gen render`) so it runs unattended. Override the whole set via
# RESUME_GEN_CLAUDE_FLAGS.
CLAUDE_FLAGS="${RESUME_GEN_CLAUDE_FLAGS:---model claude-sonnet-5 --effort medium --permission-mode acceptEdits --allowedTools Bash Read Edit Write}"

TASK="Non-interactive tailored-resume run. Working directory: $(pwd).
Follow prompts/tailor_resume.md exactly as your specification. Job description
file: $JD

Do all of this without asking any questions:
1. Read prompts/tailor_resume.md, master.yaml, and the job description ($JD).
2. Pick an output slug '<company>-<role>-$TODAY' and create output/<slug>/.
3. Copy $JD to output/<slug>/job_description.txt (audit trail).
4. Write output/<slug>/instance.yaml per the prompt: choose the profile, select
   and order bullets/highlights/skills, and include priority_order. Never invent
   facts; copy every locked field verbatim from master.yaml.
5. Render + overflow loop: run
   ./resume-gen render --instance output/<slug>/instance.yaml
   Read the JSON on stdout and the exit code. On exit 3 (overflow) follow §6 —
   drop the additional/server role first, then the lowest-priority bullets —
   editing instance.yaml and re-running, capped at 5 attempts. On exit 1 fix the
   reported locked-field/verbatim mismatch and re-run.
6. Stop at exit 0 (page_count 1), or at the 5-attempt cap per §6/§6a. Either
   way your last action must be a render, so output/<slug>/resume.pdf always
   reflects the final instance.yaml and is viewable.
7. Write output/<slug>/omitted.md per §7: a Markdown table of everything from
   master.yaml that did NOT make the final resume (bullets, the server role,
   highlights, trimmed skills), with the FULL verbatim text of each omitted
   bullet (never just its id), a never-selected-vs-overflow-cut category, and a
   reason. Reflect the final rendered state.
8. LEAD your final report with the PDF path and its page count (§6a/§8), then
   the chosen profile, which roles/bullets made the final cut, and the
   omitted.md path. This is a DRAFT for human review — never submit it anywhere."

echo "  resume-gen │ ▶ tailor  ·  JD: $JD" >&2
echo "  resume-gen │ launching headless Claude Code (prompts/tailor_resume.md) …" >&2
# shellcheck disable=SC2086
exec claude -p "$TASK" $CLAUDE_FLAGS
