#!/usr/bin/env sh
# resume-gen — one entrypoint for the whole pipeline.
#
#   resume-gen <job-description-file>          Tailor + render a resume, end to
#                                              end (headless Claude Code session,
#                                              TECH_SPEC.md §6). Resume only.
#
#   resume-gen <job-description-file> --cover  Same, and in the SAME session also
#                                              draft a matching cover letter
#                                              (prompts/tailor_cover_letter.md).
#
#   resume-gen cover-letter <output-dir>       Draft + render a cover letter for a
#                                              resume you ALREADY generated — points
#                                              at that output/<slug>/ folder and
#                                              reuses its instance.yaml + job
#                                              description. Decide per posting;
#                                              no need to re-run the resume.
#
#   resume-gen render|validate|cover ...       Deterministic, no-LLM renderer/
#                                              validator, run inside the Docker
#                                              image (build once:
#                                              docker build -t resume-gen .)
#
# Cover letters are OFF by default so a resume-only posting never pays for the
# extra drafting/render loop. Opt in with `--cover`, the `cover-letter`
# subcommand, or RESUME_GEN_COVER=1.
#
# Control direction (per TECH_SPEC §6): the launcher only *starts* Claude for
# the tailor stages — Claude then calls `resume-gen render`/`resume-gen cover`.
# The renderer itself never calls back into Claude.

set -eu

# ---- Deterministic (no-LLM) subcommands run in the container -----------------
case "${1:-}" in
  render|validate|cover|"")
    # A named volume backs Tectonic's package/font cache so it survives `--rm`
    # and is shared across every render (the image already ships a warm cache).
    exec docker run --rm \
      -v "$(pwd)":/work \
      -v resume-gen-tectonic-cache:/home/appuser/.cache/Tectonic \
      resume-gen "$@"
    ;;
  -h|--help)
    sed -n '2,30p' "$0"
    exit 0
    ;;
esac

TODAY="$(date +%F)"

# Model/effort pinned for reproducibility: Sonnet 5 / medium is a strong,
# cost-effective default for JD->selection work (the validator guards
# correctness regardless of model). Bump to `--model claude-opus-4-8 --effort
# high` for the sharpest selection, or drop to `--effort low` to trade a little
# selection quality for speed. Perms pre-authorize the tools the headless run
# needs so it runs unattended. Override the whole set via RESUME_GEN_CLAUDE_FLAGS.
CLAUDE_FLAGS="${RESUME_GEN_CLAUDE_FLAGS:---model claude-sonnet-5 --effort medium --permission-mode acceptEdits --allowedTools Bash Read Edit Write}"

# Run the headless Claude session, then record what it cost into the run's
# output folder (scripts/session_cost.py reads the session transcript). Best
# effort: cost logging never changes the run's exit code. Set RESUME_GEN_NO_COST=1
# to skip it. $2 is the output dir, or AUTO to use the newest output/*/ folder
# (the resume run picks its own slug, so we only learn it after the run).
run_claude_and_log() {
  _task="$1"; _outdir="$2"
  _start="$(date +%s)"
  set +e
  # shellcheck disable=SC2086
  claude -p "$_task" $CLAUDE_FLAGS
  _rc=$?
  set -e
  if [ "${RESUME_GEN_NO_COST:-0}" = "0" ] && command -v python3 >/dev/null 2>&1; then
    if [ "$_outdir" = "AUTO" ]; then
      _outdir="$(ls -dt output/*/ 2>/dev/null | head -1)"
    fi
    if [ -n "$_outdir" ] && [ -d "$_outdir" ]; then
      python3 scripts/session_cost.py --out "$_outdir" --since "$_start" --cwd "$(pwd)" || true
    fi
  fi
  return $_rc
}

# ---- cover-letter <output-dir>: letter for an already-generated resume -------
if [ "${1:-}" = "cover-letter" ]; then
  shift
  DIR="${1:-}"
  if [ -z "$DIR" ] || [ ! -d "$DIR" ]; then
    echo "resume-gen cover-letter: pass an existing resume output folder, e.g." >&2
    echo "  resume-gen cover-letter output/acme-analyst-$TODAY" >&2
    exit 4
  fi
  if [ ! -f "$DIR/instance.yaml" ] || [ ! -f "$DIR/job_description.txt" ]; then
    echo "resume-gen cover-letter: '$DIR' needs instance.yaml and job_description.txt" >&2
    echo "  (generate the resume first: resume-gen <job-description-file>)" >&2
    exit 4
  fi
  COVER_ONLY_TASK="Non-interactive cover-letter run. Working directory: $(pwd).
Follow prompts/tailor_cover_letter.md exactly as your specification.

Inputs (already prepared — do NOT regenerate them):
- Tailored resume: $DIR/instance.yaml   (your fact bank + letterhead source)
- Job description:  $DIR/job_description.txt

Do all of this without asking any questions:
1. Read prompts/tailor_cover_letter.md, then $DIR/instance.yaml and
   $DIR/job_description.txt. Read the target company's culture from the JD.
2. Write $DIR/cover_letter.yaml per the prompt (schema §5), grounded ONLY in
   that instance — every claim traceable to a bullet/summary/highlight it
   selected, every metric verbatim; never invent to manufacture culture-fit.
   Use today's date $TODAY, formatted like 'January 2, 2026'.
3. Run ./resume-gen cover --letter $DIR/cover_letter.yaml and drive its
   one-page loop: exit 0 done; exit 3 (overflow) tighten prose and re-render;
   exit 1/2 fix cover_letter.yaml and re-run. Cap 4 attempts; ALWAYS end on a
   render so $DIR/cover_letter.pdf is viewable.
4. LEAD your report with the cover_letter.pdf path and its page count, then the
   addressee you chose and one line on how you matched the company's culture.
   This is a DRAFT for human review — never submit it anywhere."
  echo "  resume-gen │ ▶ cover-letter  ·  folder: $DIR" >&2
  echo "  resume-gen │ launching headless Claude Code (prompts/tailor_cover_letter.md) …" >&2
  run_claude_and_log "$COVER_ONLY_TASK" "$DIR"
  exit $?
fi

# ---- Resume tailor stage (optionally + cover letter) -------------------------
# Parse: exactly one <job-description-file>, plus optional --cover / --no-cover.
WANT_COVER=0
JD_INPUT=""
for arg in "$@"; do
  case "$arg" in
    --cover)    WANT_COVER=1 ;;
    --no-cover) WANT_COVER=0 ;;
    -*) echo "resume-gen: unknown option '$arg'." >&2; exit 4 ;;
    *)
      if [ -n "$JD_INPUT" ]; then
        echo "resume-gen: pass a single job-description file (got '$JD_INPUT' and '$arg')." >&2
        exit 4
      fi
      JD_INPUT="$arg" ;;
  esac
done
if [ -z "$JD_INPUT" ] || [ ! -f "$JD_INPUT" ]; then
  echo "resume-gen: '$JD_INPUT' is not a file. Pass a job-description file, add --cover" >&2
  echo "for a cover letter too, or use 'render'/'validate'/'cover-letter'." >&2
  exit 4
fi
JD="$(realpath "$JD_INPUT")"

# Cover letter rides the SAME session (it already has the JD and instance in
# context, so grounding is free). Off unless --cover or RESUME_GEN_COVER=1.
GEN_COVER="${RESUME_GEN_COVER:-$WANT_COVER}"
if [ "$GEN_COVER" != "0" ]; then
  COVER_TASK="8. Cover letter — SAME session, reusing the instance.yaml you just wrote as
   the fact bank (do not re-open master.yaml for facts): read
   prompts/tailor_cover_letter.md and follow it exactly. Read the target
   company's culture from the job description and mirror its register. Write
   output/<slug>/cover_letter.yaml (its schema §5), grounded ONLY in that
   instance — every claim traceable to a bullet/summary/highlight it selected,
   every metric verbatim; never invent to manufacture culture-fit. Then run
   ./resume-gen cover --letter output/<slug>/cover_letter.yaml and drive its
   one-page loop: exit 0 done; exit 3 (overflow) tighten prose and re-render;
   exit 1/2 fix cover_letter.yaml and re-run. Cap 4 attempts; ALWAYS end on a
   render so output/<slug>/cover_letter.pdf is viewable."
  COVER_REPORT=", then the cover_letter.pdf path and how you matched the company's culture"
else
  COVER_TASK=""
  COVER_REPORT=""
fi

TASK="Non-interactive tailored-application run. Working directory: $(pwd).
Follow prompts/tailor_resume.md exactly as your specification. Job description
file: $JD

Do all of this without asking any questions:
1. Read prompts/tailor_resume.md, master.yaml, and the job description ($JD).
2. Pick an output slug '<company>-<role>-$TODAY' and create output/<slug>/.
3. Copy $JD to output/<slug>/job_description.txt (audit trail).
4. Write output/<slug>/instance.yaml per the prompt: choose the profile, select
   and order bullets/highlights/skills, and include priority_order. Aim to fit
   one page on the FIRST render (§3) — select conservatively so the overflow
   loop is a fallback, not the plan. Never invent facts; copy every locked field
   verbatim from master.yaml.
5. Render + overflow loop: run
   ./resume-gen render --instance output/<slug>/instance.yaml
   Read the JSON on stdout and the exit code:
   - Exit 3 (overflow): the JSON's `fit.lines_over` estimates how many lines you
     are past one page — trim about that much in ONE edit (per §6: the
     additional/server role first, then the lowest-priority bullets), not one
     line at a time, then re-run. Cap 5 attempts.
   - Exit 1: fix the reported locked-field/verbatim mismatch and re-run.
   - Exit 0 (one page): check `fit.lines_free` and `coverage.selection_gap`. If
     there is free room AND the JD has key terms you already cover in master.yaml
     but did not select (selection_gap), swap the most relevant omitted bullet
     back in — copied VERBATIM from master.yaml, never reworded or invented — to
     raise coverage, then re-render. Keep the swap only if it still fits (exit 0);
     otherwise revert. Stop once there is no worthwhile swap or no room.
6. Finish at a one-page render (exit 0), or at the 5-attempt cap per §6/§6a.
   Either way your last action must be a render, so output/<slug>/resume.pdf
   always reflects the final instance.yaml and is viewable.
7. Write output/<slug>/omitted.md per §7: a Markdown table of everything from
   master.yaml that did NOT make the final resume (bullets, the server role,
   highlights, trimmed skills), with the FULL verbatim text of each omitted
   bullet (never just its id), a never-selected-vs-overflow-cut category, and a
   reason. Reflect the final rendered state.
$COVER_TASK
Finally, LEAD your report with the resume PDF path and its page count (§6a/§8),
then the chosen profile, which roles/bullets made the final cut, the omitted.md
path$COVER_REPORT. This is a DRAFT for human review — never submit it anywhere."

echo "  resume-gen │ ▶ tailor  ·  JD: $JD" >&2
if [ "$GEN_COVER" != "0" ]; then
  echo "  resume-gen │ launching headless Claude Code (resume + cover letter) …" >&2
else
  echo "  resume-gen │ launching headless Claude Code (resume only; add --cover for a letter) …" >&2
fi
run_claude_and_log "$TASK" "AUTO"
exit $?
