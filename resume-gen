#!/usr/bin/env sh
# resume-gen — one entrypoint for the whole pipeline.
#
#   resume-gen <job-description-file>          Tailor + render a resume, end to
#                                              end (headless Claude Code session,
#                                              TECH_SPEC.md §6). Resume only.
#
#   resume-gen <job-description-file> --cover  Same, and in the SAME session also
#                                              draft a matching cover letter
#                                              (prompts/tailor_cover_letter.md).
#
#   resume-gen <job-description-file> --fast   Same, but use the cheaper Sonnet 5
#                                              /medium tier instead of the default
#                                              Opus 5/high — for routine, bulk,
#                                              or low-match runs (RESUME_GEN_FAST=1
#                                              does the same). Combines with --cover.
#
#   resume-gen cover-letter <output-dir>       Draft + render a cover letter for a
#                                              resume you ALREADY generated — points
#                                              at that output/<slug>/ folder and
#                                              reuses its instance.yaml + job
#                                              description. Decide per posting;
#                                              no need to re-run the resume.
#
#   resume-gen render|validate|cover ...       Deterministic, no-LLM renderer/
#                                              validator, run inside the Docker
#                                              image (build once:
#                                              docker build -t resume-gen .)
#
#   resume-gen eval <job-description-file>     A/B the tailor stage: run it twice
#                                              at two model/effort settings and
#                                              write a side-by-side eval.md
#                                              (coverage, pages, cost). See
#                                              scripts/eval_run.py --help.
#
#   resume-gen gaps                            Aggregate the content gaps across
#                                              every tailored run into
#                                              output/gap_digest.md — JD terms
#                                              your master.yaml has nothing on,
#                                              ranked by how many postings wanted
#                                              them. A to-write list, not a
#                                              to-fake list. See
#                                              scripts/gap_digest.py --help.
#
# Cover letters are OFF by default so a resume-only posting never pays for the
# extra drafting/render loop. Opt in with `--cover`, the `cover-letter`
# subcommand, or RESUME_GEN_COVER=1.
#
# Control direction (per TECH_SPEC §6): the launcher only *starts* Claude for
# the tailor stages — Claude then calls `resume-gen render`/`resume-gen cover`.
# The renderer itself never calls back into Claude.

set -eu

# `--fast` selects the cheaper Sonnet 5 / medium tier for the LLM tailor + cover
# stages (see the model note below). Pull it out of the args here — before the
# subcommand dispatch — so it works in any position and nothing downstream has
# to know about it. RESUME_GEN_FAST=1 does the same. The rotate loop rebuilds
# "$@" without --fast while preserving the order (and spaces) of every other arg.
FAST="${RESUME_GEN_FAST:-0}"
_n=$#
while [ "$_n" -gt 0 ]; do
  _a="$1"; shift
  if [ "$_a" = "--fast" ]; then FAST=1; else set -- "$@" "$_a"; fi
  _n=$((_n - 1))
done

# ---- Deterministic (no-LLM) subcommands run in the container -----------------
case "${1:-}" in
  render|validate|cover|"")
    # A named volume backs Tectonic's package/font cache so it survives `--rm`
    # and is shared across every render (the image already ships a warm cache).
    # Forward RESUME_GEN_MASTER so the containerized render/validate default to
    # the same bank as the host (default ./master.yaml, mounted under /work).
    exec docker run --rm \
      -v "$(pwd)":/work \
      -v resume-gen-tectonic-cache:/home/appuser/.cache/Tectonic \
      -e RESUME_GEN_MASTER="${RESUME_GEN_MASTER:-master.yaml}" \
      resume-gen "$@"
    ;;
  eval)
    shift
    exec python3 scripts/eval_run.py "$@"
    ;;
  gaps)
    shift
    exec python3 scripts/gap_digest.py "$@"
    ;;
  -h|--help)
    sed -n '2,51p' "$0"
    exit 0
    ;;
esac

TODAY="$(date +%F)"

# Optional slug suffix, threaded into the task prompt. The eval harness sets
# this (e.g. "-opus-high") so two tailor runs on the SAME posting on the SAME
# day land in distinct output/ folders instead of fighting over one slug.
SLUG_SUFFIX="${RESUME_GEN_SLUG_SUFFIX:-}"

# Model/effort: default Opus 5 / high. Bullet selection is the one judgment
# call in this pipeline that nothing downstream can repair — validate.py proves
# the result is *truthful* and coverage.py scores its keyword fit, but neither
# can tell whether the bullets chosen were the most persuasive ones for this
# posting. The 2026-07-28 eval (run against Opus 4.8, the tier available at the
# time) settled that this is worth paying for on the postings that matter: on a
# well-matched JD, Opus/high kept a quantified, on-target bullet that
# Sonnet/medium dropped, and a blind judge preferred it (see SESSION_HANDOFF.md).
# On a poorly-matched JD the two produce identical output — so `--fast`
# (Sonnet 5 / medium) is the right call for routine, bulk, or low-match runs:
# ~60% cheaper and ~20% faster for the same result there. (Opus/medium was
# measured to be the worst value — near-Opus/high cost with no benefit — so it
# is deliberately not offered.) Perms pre-authorize the tools the headless run
# needs so it runs unattended. RESUME_GEN_CLAUDE_FLAGS overrides both the model
# choice and --fast entirely.
if [ "$FAST" != "0" ]; then
  _MODEL_FLAGS="--model claude-sonnet-5 --effort medium"
else
  _MODEL_FLAGS="--model claude-opus-5 --effort high"
fi
CLAUDE_FLAGS="${RESUME_GEN_CLAUDE_FLAGS:-$_MODEL_FLAGS --permission-mode acceptEdits --allowedTools Bash Read Edit Write}"

# Run the headless Claude session through scripts/run_and_capture.py, which
# mirrors its stdout unchanged (so streaming/narration downstream sees exactly
# what it always did) while reading this run's OWN session id and chosen
# output/<slug>/ straight off its OWN stream-json events -- into --info-file,
# not off shared state. That's what makes $2=AUTO and the transcript lookup
# below safe with more than one of these running at once: "newest output/*/
# folder" and "newest transcript file" are both races across concurrent runs;
# this run's info-file only ever reflects this run's child process.
#
# Then record what it cost into the run's output folder (session_cost.py
# reads the session transcript by session id when we have one), and append
# this run's SESSION_HANDOFF.md Log line deterministically (append_handoff_log.py
# -- see its docstring: the agent no longer hand-edits that file for automated
# runs, precisely because two of THEM editing it at once is the read-modify-
# write race concurrent runs would otherwise hit). Both are best effort: never
# change the run's exit code. Set RESUME_GEN_NO_COST=1 / RESUME_GEN_NO_HANDOFF_LOG=1
# to skip either. $2 is the output dir, or AUTO to use the slug this run
# detected (falling back to the newest output/*/ folder if detection came up
# empty -- only safe there in the no-concurrency case, same as before this
# change). $3 is "tailor" or "cover-letter", for the handoff line's wording.
run_claude_and_log() {
  _task="$1"; _outdir="$2"; _kind="${3:-tailor}"
  _start="$(date +%s)"
  _info_file="$(mktemp)"
  set +e
  # shellcheck disable=SC2086
  python3 scripts/run_and_capture.py --info-file "$_info_file" -- claude -p "$_task" $CLAUDE_FLAGS
  _rc=$?
  set -e
  _sid=""
  _slug=""
  if [ -s "$_info_file" ] && command -v python3 >/dev/null 2>&1; then
    _sid="$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('session_id') or '')" "$_info_file" 2>/dev/null || true)"
    _slug="$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('slug') or '')" "$_info_file" 2>/dev/null || true)"
  fi
  rm -f "$_info_file"
  if [ "$_outdir" = "AUTO" ]; then
    if [ -n "$_slug" ] && [ -d "output/$_slug" ]; then
      _outdir="output/$_slug"
    else
      _outdir="$(ls -dt output/*/ 2>/dev/null | head -1)"
    fi
  fi
  # Prefer the detected slug (exact) over deriving it from $_outdir's basename
  # (also fine -- $_outdir is either "output/<slug>" or empty by this point).
  if [ -z "$_slug" ] && [ -n "$_outdir" ]; then
    _slug="$(basename "$_outdir")"
  fi
  if [ "${RESUME_GEN_NO_COST:-0}" = "0" ] && command -v python3 >/dev/null 2>&1 \
     && [ -n "$_outdir" ] && [ -d "$_outdir" ]; then
    python3 scripts/session_cost.py --out "$_outdir" --since "$_start" --cwd "$(pwd)" \
      ${_sid:+--session-id "$_sid"} || true
  fi
  if [ "${RESUME_GEN_NO_HANDOFF_LOG:-0}" = "0" ] && command -v python3 >/dev/null 2>&1 \
     && [ -n "$_slug" ]; then
    python3 scripts/append_handoff_log.py --slug "$_slug" --kind "$_kind" \
      --exit-code "$_rc" --cwd "$(pwd)" || true
  fi
  return $_rc
}

# ---- cover-letter <output-dir>: letter for an already-generated resume -------
if [ "${1:-}" = "cover-letter" ]; then
  shift
  DIR="${1:-}"
  if [ -z "$DIR" ] || [ ! -d "$DIR" ]; then
    echo "resume-gen cover-letter: pass an existing resume output folder, e.g." >&2
    echo "  resume-gen cover-letter output/acme-analyst-$TODAY" >&2
    exit 4
  fi
  if [ ! -f "$DIR/instance.yaml" ] || [ ! -f "$DIR/job_description.txt" ]; then
    echo "resume-gen cover-letter: '$DIR' needs instance.yaml and job_description.txt" >&2
    echo "  (generate the resume first: resume-gen <job-description-file>)" >&2
    exit 4
  fi
  COVER_ONLY_TASK="Non-interactive cover-letter run. Working directory: $(pwd).
Follow prompts/tailor_cover_letter.md exactly as your specification.

Inputs (already prepared — do NOT regenerate them):
- Tailored resume: $DIR/instance.yaml   (your fact bank + letterhead source)
- Job description:  $DIR/job_description.txt

Do all of this without asking any questions:
1. Read prompts/tailor_cover_letter.md, then $DIR/instance.yaml and
   $DIR/job_description.txt. Read the target company's culture from the JD.
2. Write $DIR/cover_letter.yaml per the prompt (schema §5), grounded ONLY in
   that instance — every claim traceable to a bullet/summary/highlight it
   selected, every metric verbatim; never invent to manufacture culture-fit.
   Use today's date $TODAY, formatted like 'January 2, 2026'.
3. Run ./resume-gen cover --letter $DIR/cover_letter.yaml and drive its
   one-page loop: exit 0 done; exit 3 (overflow) tighten prose and re-render;
   exit 1/2 fix cover_letter.yaml and re-run. Cap 4 attempts; ALWAYS end on a
   render so $DIR/cover_letter.pdf is viewable.
4. Do NOT edit SESSION_HANDOFF.md yourself: the launcher appends this run's
   Log entry automatically once your session ends
   (scripts/append_handoff_log.py) — CLAUDE.md's usual every-agent-updates-
   the-handoff rule is deliberately overridden for this automated path,
   precisely because concurrent runs hand-editing that file at the same time
   is a lost-update race. Leave it alone.
5. LEAD your report with the cover_letter.pdf path and its page count, then the
   addressee you chose and one line on how you matched the company's culture.
   This is a DRAFT for human review — never submit it anywhere."
  echo "  resume-gen │ ▶ cover-letter  ·  folder: $DIR" >&2
  echo "  resume-gen │ launching headless Claude Code (prompts/tailor_cover_letter.md) …" >&2
  run_claude_and_log "$COVER_ONLY_TASK" "$DIR" cover-letter
  exit $?
fi

# ---- Resume tailor stage (optionally + cover letter) -------------------------
# Parse: exactly one <job-description-file>, plus optional --cover / --no-cover.
WANT_COVER=0
JD_INPUT=""
for arg in "$@"; do
  case "$arg" in
    --cover)    WANT_COVER=1 ;;
    --no-cover) WANT_COVER=0 ;;
    -*) echo "resume-gen: unknown option '$arg'." >&2; exit 4 ;;
    *)
      if [ -n "$JD_INPUT" ]; then
        echo "resume-gen: pass a single job-description file (got '$JD_INPUT' and '$arg')." >&2
        exit 4
      fi
      JD_INPUT="$arg" ;;
  esac
done
if [ -z "$JD_INPUT" ] || [ ! -f "$JD_INPUT" ]; then
  echo "resume-gen: '$JD_INPUT' is not a file. Pass a job-description file, add --cover" >&2
  echo "for a cover letter too, or use 'render'/'validate'/'cover-letter'." >&2
  exit 4
fi
JD="$(realpath "$JD_INPUT")"

# The content bank the headless agent reads. Default ./master.yaml (back-compat);
# RESUME_GEN_MASTER points the whole pipeline at a bank living elsewhere.
MASTER="${RESUME_GEN_MASTER:-master.yaml}"

# Cover letter rides the SAME session (it already has the JD and instance in
# context, so grounding is free). Off unless --cover or RESUME_GEN_COVER=1.
GEN_COVER="${RESUME_GEN_COVER:-$WANT_COVER}"
if [ "$GEN_COVER" != "0" ]; then
  COVER_TASK="8. Cover letter — SAME session, reusing the instance.yaml you just wrote as
   the fact bank (do not re-open $MASTER for facts): read
   prompts/tailor_cover_letter.md and follow it exactly. Read the target
   company's culture from the job description and mirror its register. Write
   output/<slug>/cover_letter.yaml (its schema §5), grounded ONLY in that
   instance — every claim traceable to a bullet/summary/highlight it selected,
   every metric verbatim; never invent to manufacture culture-fit. Then run
   ./resume-gen cover --letter output/<slug>/cover_letter.yaml and drive its
   one-page loop: exit 0 done; exit 3 (overflow) tighten prose and re-render;
   exit 1/2 fix cover_letter.yaml and re-run. Cap 4 attempts; ALWAYS end on a
   render so output/<slug>/cover_letter.pdf is viewable."
  COVER_REPORT=", then the cover_letter.pdf path and how you matched the company's culture"
else
  COVER_TASK=""
  COVER_REPORT=""
fi

TASK="Non-interactive tailored-application run. Working directory: $(pwd).
Follow prompts/tailor_resume.md exactly as your specification. Job description
file: $JD

Do all of this without asking any questions:
1. Read prompts/tailor_resume.md, $MASTER, and the job description ($JD).
2. Pick an output slug '<company>-<role>-$TODAY$SLUG_SUFFIX' and create output/<slug>/.
   If that folder already exists (a concurrent run may have just claimed it),
   append '-b', then '-c', etc. until \`mkdir output/<slug>\` succeeds — never
   write into a folder you didn't create yourself.
3. Copy $JD to output/<slug>/job_description.txt (audit trail).
4. Write output/<slug>/instance.yaml per the prompt: choose the profile, select
   and order bullets/highlights/skills, and include priority_order. Aim to fit
   one page on the FIRST render (§3) — select conservatively so the overflow
   loop is a fallback, not the plan. Never invent facts; copy every locked field
   verbatim from $MASTER.
5. Render + overflow loop: run
   ./resume-gen render --instance output/<slug>/instance.yaml
   Read the JSON on stdout and the exit code:
   - Exit 3 (overflow): the JSON's \`fit.lines_over\` estimates how many lines you
     are past one page — trim about that much in ONE edit (per §6: the
     additional/server role first, then the lowest-priority bullets), not one
     line at a time, then re-run. Cap 5 attempts.
   - Exit 1: fix the reported locked-field/verbatim mismatch and re-run.
   - Exit 0 (one page): check \`fit.lines_free\` and \`coverage.selection_gap\`. If
     there is free room AND the JD has key terms you already cover in $MASTER
     but did not select (selection_gap), swap the most relevant omitted bullet
     back in — copied VERBATIM from $MASTER, never reworded or invented — to
     raise coverage, then re-render. Keep the swap only if it still fits (exit 0);
     otherwise revert. Stop once there is no worthwhile swap or no room.
6. Finish at a one-page render (exit 0), or at the 5-attempt cap per §6/§6a.
   Either way your last action must be a render, so output/<slug>/resume.pdf
   always reflects the final instance.yaml and is viewable.
7. Write output/<slug>/omitted.md per §7: a Markdown table of everything from
   $MASTER that did NOT make the final resume (bullets, the server role,
   highlights, trimmed skills), with the FULL verbatim text of each omitted
   bullet (never just its id), a never-selected-vs-overflow-cut category, and a
   reason. Reflect the final rendered state.
$COVER_TASK
Do NOT edit SESSION_HANDOFF.md yourself: the launcher appends this run's Log
entry automatically once your session ends (scripts/append_handoff_log.py) —
CLAUDE.md's usual every-agent-updates-the-handoff rule is deliberately
overridden for this automated path, precisely because concurrent runs hand-
editing that file at the same time is a lost-update race. Leave it alone.
Finally, LEAD your report with the resume PDF path and its page count (§6a/§8),
then the chosen profile, which roles/bullets made the final cut, the omitted.md
path$COVER_REPORT. This is a DRAFT for human review — never submit it anywhere."

echo "  resume-gen │ ▶ tailor  ·  JD: $JD" >&2
if [ "$GEN_COVER" != "0" ]; then
  echo "  resume-gen │ launching headless Claude Code (resume + cover letter) …" >&2
else
  echo "  resume-gen │ launching headless Claude Code (resume only; add --cover for a letter) …" >&2
fi
run_claude_and_log "$TASK" "AUTO" tailor
exit $?
